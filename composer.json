{
    "name": "arjanvlek/failed-login-attempts-counter",
    "description": "WordPress plugin that counts successful and failed login attempts on wp-login.php.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^3.1"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find . -name '*.php' -not -path './vendor/*' -not -path './build/*' -print0 | xargs -0 -n1 -P4 php -l > /dev/null && echo 'Lint OK'",
        "build": "bin/build.sh"
    },
    "config": {
        "sort-packages": true
    }
}
